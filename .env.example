# Supabase project — copy this file to .env.local and fill in real values.
# Get URL + anon key from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: public site URL (used for canonical/OG tags later if you generate them at build time)
VITE_SITE_URL=https://www.voltamotorbuyukcekmece.com

# =========================================================================
# Server-side only — used by the api/contact serverless function on Vercel.
# These are NOT prefixed with VITE_ and are never exposed to the browser.
# Set them in Vercel → Project → Settings → Environment Variables.
# =========================================================================

# Resend API key — required to send contact-form emails. https://resend.com
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# Sender shown in the email "from" field. Until you verify your own domain in
# Resend, you can use the sandbox sender below, which ONLY delivers to the
# email address that owns the Resend account:
CONTACT_FROM_EMAIL=Volta Bayi <onboarding@resend.dev>

# Where contact-form submissions are emailed:
CONTACT_TO_EMAIL=cdhmotorluaraclar@gmail.com

# Optional: enables the audit log (admin → Mesajlar). Use the SAME values as
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY above. Requires migration 0007.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
